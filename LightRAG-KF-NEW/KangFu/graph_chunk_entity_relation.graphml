  <data key="d2">chunk-0a7abf467a8b1da896b788e651526495</data>
</node>
<node id="&quot;KNEE ROM&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Range of motion of the knee, a measurement used in physical therapy and orthopedic assessments."</data>
  <data key="d2">chunk-0a7abf467a8b1da896b788e651526495</data>
</node>
<node id="&quot;30 PATIENTS&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"A group of 30 patients who had undergone total knee arthroplasty, used in the study by Lessen and associates."</data>
  <data key="d2">chunk-0a7abf467a8b1da896b788e651526495</data>
</node>
<node id="&quot;25 CHILDREN WITH SPASTIC CEREBRAL PALSY&quot;">
  <data key="d0">"CATEGORY"</data>
