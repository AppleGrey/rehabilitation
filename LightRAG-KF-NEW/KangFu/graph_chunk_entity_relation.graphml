  <data key="d0">"EVENT"</data>
  <data key="d1">"A surgical procedure to replace a damaged knee joint with an artificial one."&lt;SEP&gt;"Total knee arthroplasty is a surgical procedure to replace a damaged knee joint with an artificial one."</data>
  <data key="d2">chunk-90aa2c67eee53a88d282d9e6987ca28b&lt;SEP&gt;chunk-0a7abf467a8b1da896b788e651526495</data>
</node>
