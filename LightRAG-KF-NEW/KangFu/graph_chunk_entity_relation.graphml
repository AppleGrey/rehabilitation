  <data key="d2">chunk-0a7abf467a8b1da896b788e651526495</data>
</node>
<node id="&quot;42 HEALTHY VOLUNTEERS&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"A group of 42 healthy volunteers used in the study by Cleffken and associates to assess intratester and intertester reproducibility of knee flexion and extension measurements."</data>
  <data key="d2">chunk-0a7abf467a8b1da896b788e651526495</data>
</node>
<node id="&quot;37 HEALTHY VOLUNTEERS&quot;">
