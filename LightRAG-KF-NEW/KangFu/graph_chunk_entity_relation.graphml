  <data key="d0">"EVENT"</data>
  <data key="d1">"A method of measuring knee flexion where the patient lies flat on their back, often used as a standard measure of knee ROM."</data>
  <data key="d2">chunk-90aa2c67eee53a88d282d9e6987ca28b</data>
</node>
<node id="&quot;SQUAT FLEXION&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"A method of measuring knee flexion where the patient performs a squat, providing a more functional measure of knee ROM."</data>
  <data key="d2">chunk-90aa2c67eee53a88d282d9e6987ca28b</data>
</node>
