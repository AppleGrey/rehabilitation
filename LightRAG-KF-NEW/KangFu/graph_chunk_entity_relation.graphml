  <data key="d5">"development, research"</data>
  <data key="d6">chunk-5ef81e2a2ef718984fd40ce92806308f</data>
</edge>
<edge source="&quot;KNEE EXTENSION&quot;" target="&quot;BOONE&quot;">
  <data key="d3">6.0</data>
  <data key="d4">"Boone noted that children between 1 year and 5 years of age have a mean of 5.4 degrees of extension beyond 0 degrees, contributing to the understanding of normal knee extension in young children."</data>
  <data key="d5">"research, normal range"</data>
  <data key="d6">chunk-5ef81e2a2ef718984fd40ce92806308f</data>
