</edge>
<edge source="&quot;KNEE EXTENSION&quot;" target="&quot;WANATABE AND ASSOCIATES&quot;">
  <data key="d3">8.0</data>
  <data key="d4">"Wanatabe and Associates found that newborns lack about 14 degrees of knee extension, which gradually disappears by the age of 2 years."</data>
  <data key="d5">"research, development"</data>
  <data key="d6">chunk-5ef81e2a2ef718984fd40ce92806308f</data>
</edge>
