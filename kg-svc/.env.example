# ── kg-svc 配置 ───────────────────────────────────────────────
# SiliconFlow(硅基流动) bge-m3 向量化（必填，请填入你的 key）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
KG_EMBED_MODEL=BAAI/bge-m3
KG_EMBED_DIM=1024

# 知识图谱工作目录：先用小图 KangFu 联调；切生产改为 KangFu-Full-QwQ-32B-AWQ
KG_WORKING_DIR=D:/codes/rehabilitation/kg-svc/LightRAG-KF-NEW/KangFu

# DeepSeek 默认复用项目根 .env，无需在此重复；如需覆盖可取消注释
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
