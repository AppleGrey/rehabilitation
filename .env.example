# 对话 / 问诊（必填）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 动作评估（使用 /api/assess 时必填）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.6-plus
# 推理模型评估：关闭思考、留足输出 token（可选）
# ASSESSMENT_MAX_TOKENS=4096
# ASSESSMENT_ENABLE_THINKING=false

# ffmpeg 一般无需修改（镜像内已安装）
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# PostgreSQL（本地默认无密码）
DATABASE_URL=postgresql://postgres@localhost:5432/rehabilitation
# 建库用管理库连接（库不存在时自动创建）
DATABASE_ADMIN_URL=postgresql://postgres@localhost:5432/postgres

# MinIO（本地 Docker）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rehabilitation-files
MINIO_SECURE=false
