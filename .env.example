# 问诊 / 视觉大模型的密钥在管理平台「配置管理」里修改。
# 下面几项只在数据库还没有对应配置时，作为第一次启动的初始值。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.6-plus
# 仅第一次写入视觉配置时使用
# ASSESSMENT_MAX_TOKENS=4096
# ASSESSMENT_ENABLE_THINKING=false

# ffmpeg 一般无需修改（镜像内已安装）
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# PostgreSQL（本地默认无密码）
DATABASE_URL=postgresql://postgres@localhost:5432/rehabilitation
# 建库用管理库连接（库不存在时自动创建）
DATABASE_ADMIN_URL=postgresql://postgres@localhost:5432/postgres

# MinIO（本地 Docker）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rehabilitation-files
MINIO_SECURE=false

# ── 用户体系与鉴权 ──────────────────────────────────────────────────────────
# JWT 签名密钥。core-svc 签发、admin-svc 与 ai-svc 验签，三者必须完全一致。
# 生产环境务必换成随机值，例如： openssl rand -hex 32
JWT_SECRET=dev-insecure-secret-change-me
# App 端令牌有效期（小时，默认 30 天）
JWT_TTL_HOURS=720
# 管理端令牌有效期（小时，默认 12 小时，比 App 短）
JWT_ADMIN_TTL_HOURS=12

# 服务间调用凭证：ai-svc / admin-svc 访问 core-svc 的 /api/programs* 时携带
# （请求头 X-Service-Token）。生产环境同样要换成随机值。
SERVICE_TOKEN=dev-service-token

# 首次启动时自动创建的超级管理员（已存在超管则跳过，不会重置密码）。
# 登录管理平台后请立刻在「用户管理」里改掉初始密码。
SUPERADMIN_PHONE=13800000000
SUPERADMIN_PASSWORD=admin12345

